{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A video analysis project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "updatedAt": { "type": "number" },
        "videoUrl": { "type": "string" },
        "durationInput": { "type": "string" },
        "chunkSize": { "type": "number" },
        "overlap": { "type": "number" },
        "customContext": { "type": "string" },
        "softwareName": { "type": "string" },
        "glossaryPath": { "type": "string" },
        "chunks": { "type": "string" },
        "actions": { "type": "string" },
        "annotations": { "type": "string" },
        "narrativeSteps": { "type": "string" },
        "procState": { "type": "string" },
        "latestUIState": { "type": "string" },
        "status": { "type": "string" },
        "actionCount": { "type": "number" }
      },
      "required": ["id", "userId", "name", "updatedAt", "status"]
    },
    "Vocabulary": {
      "title": "Vocabulary",
      "description": "A custom vocabulary file for a specific software",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "softwareName": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "softwareName", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User projects"
    },
    "/vocabularies/{vocabularyId}": {
      "schema": { "$ref": "#/entities/Vocabulary" },
      "description": "User custom vocabularies"
    }
  }
}
